---
import { BASE as base } from '../base';
---
<footer class="flex flex-wrap items-center ph3 pt5 pb4 white bg-near-black">
    <div class="footer__logoWrap w-100 w-20-l">
        <img class="logo db w-100" alt="all county investigations security guard training" src={`${base}images/aci-logo-small-white.png`} />
        <ul class="pv4 ph0 ma0 list">
            <li>
                <a class="dib pv2 pr2 white link" href="https://www.facebook.com/All-County-Security-Guard-Training-417202011668011/" target="_blank">
                    <i class="fab fa-facebook f3"></i>
                </a>
                <a class="dib pv2 ph2 white link" href="https://twitter.com/county_guard" target="_blank">
                    <i class="fab fa-twitter f3"></i>
                </a>
                {/* <a class="dib pv2 ph2 white link" href="#" target="_blank">
                    <i class="fab fa-linkedin f3"></i>
                </a> */}
            </li>
        </ul>
    </div>
    <div class="footer__sitemap w-100 w-80-l">
        <ul class="list pv4 ph0 flex flex-column flex-row-l justify-end">
            <li class="dib ph3"><a class="db pv2 f4 white link" href={base}>Home</a></li>
            <li class="dib ph3"><a class="db pv2 f4 white link" href={`${base}about-your-instructor`}>About Your Instructor</a></li>
            <li class="dib ph3"><a class="db pv2 f4 white link" href={`${base}training-courses`}>Training Courses</a></li>
            <li class="dib ph3"><a class="db pv2 f4 white link" href={`${base}becoming-a-security-guard`}>Becoming A Security Guard</a></li>
            <li class="dib ph3"><a class="db pv2 f4 white link" href={`${base}faq`}>FAQ</a></li>
        </ul>
    </div>
    <div class="footer__copyright w-100 mt5 lh-copy">
        <span class="db tc f6">&copy; 2018 <a class="white" href="https://allcountyinvestigations.com" target="_blank">All County Investigations, Inc.</a></span>
        <span class="db tc f6"><a class="white" href="mailto:allcountypi@gmail.com">allcountypi@gmail.com</a></span>
        <span class="db mt2 tc f6">Designed by: <a class="white" href="https://www.causeofakind.com" target="_blank">Cause of a Kind, LLC</a></span>
    </div>
</footer>
