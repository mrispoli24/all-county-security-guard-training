---
import { BASE as base } from '../base';
---
<header class="flex items-center justify-between pa3 bb b--near-black">
    <div class="header__logoWrap pr4">
        <a class="db" href={base}>
            <img class="logo db w-100" alt="all county investigations" src={`${base}images/aci-logo-small-black.png`} />
        </a>
    </div>
    <div class="header__navOpenWrap tr">
        <span class="header__navOpenTrigger pointer"><i class="fas fa-align-right f3"></i></span>
    </div>
</header>
